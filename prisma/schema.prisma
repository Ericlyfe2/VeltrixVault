// VeltrixVault database schema
// Local development uses SQLite. See docs/deployment.md for the Postgres path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  referralCode    String    @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  tokens      VerificationToken[]
  analyses    Analysis[]
  watchlist   WatchlistItem[]
  referrals   Referral[]          @relation("Referrer")
  referredBy  Referral?           @relation("Referee")
  auditEvents AuditEvent[]

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  type      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Competition {
  id          String  @id
  slug        String
  name        String
  country     String
  countryCode String
  season      String
  accent      String
  isComplete  Boolean @default(false)
  source      String  @default("OpenFootball")

  teams   Team[]
  matches Match[]

  @@unique([slug, season])
  @@index([season])
}

model Team {
  id        String @id
  name      String
  shortName String
  slug      String
  monogram  String
  color     String

  played       Int @default(0)
  wins         Int @default(0)
  draws        Int @default(0)
  losses       Int @default(0)
  goalsFor     Int @default(0)
  goalsAgainst Int @default(0)
  points       Int @default(0)

  homeGoalsFor     Int @default(0)
  homeGoalsAgainst Int @default(0)
  awayGoalsFor     Int @default(0)
  awayGoalsAgainst Int @default(0)

  form String @default("")

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  watchlistItems WatchlistItem[]

  @@index([competitionId, points])
  @@index([slug])
}

model Match {
  id            String @id
  round         String
  date          String
  homeTeam      String
  awayTeam      String
  homeGoals     Int
  awayGoals     Int
  competitionId String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@index([competitionId, date])
}

model Analysis {
  id            String @id @default(cuid())
  userId        String
  competitionId String
  homeTeamId    String
  awayTeamId    String

  title        String
  notes        String?
  homeWin      Float
  draw         Float
  awayWin      Float
  over25       Float
  btts         Float
  expectedHome Float
  expectedAway Float
  scoreline    String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String   @unique
  code       String
  createdAt  DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  meta      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

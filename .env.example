# ---------------------------------------------------------------------------
# VeltrixVault environment
# Copy this file to .env (never commit .env) and adjust for your machine.
# ---------------------------------------------------------------------------

# Local development database (SQLite).
DATABASE_URL="file:./dev.db"

# Public origin used for emails, invite links and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used to pseudonymise IP addresses in the audit trail. Set a long random value
# in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET="change-me-in-production"

# --- Optional transactional email -------------------------------------------
# Without a provider, verification and reset links are logged to the server
# console. Development builds also return the link to the originating form so
# the flow can be tested end-to-end.
RESEND_API_KEY=""
MAIL_FROM="VeltrixVault <no-reply@example.com>"

# --- Production notes -------------------------------------------------------
# NODE_ENV is managed by Next.js. When NODE_ENV=production, secure cookies and
# strict security headers are enabled automatically.
